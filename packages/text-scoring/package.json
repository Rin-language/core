{
  "name": "@rin-language/text-scoring",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./sudachi": {
      "types": "./dist/sudachi/index.d.ts",
      "default": "./dist/sudachi/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check-build": "node --input-type=module -e \"const m = await import('@rin-language/text-scoring'); if (typeof m.createJapaneseTextScorer !== 'function') process.exit(1)\""
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "@nikkei/napi-sudachi": "0.12.0"
  },
  "peerDependenciesMeta": {
    "@nikkei/napi-sudachi": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nikkei/napi-sudachi": "0.12.0"
  }
}
